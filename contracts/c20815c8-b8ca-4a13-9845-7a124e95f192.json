{"UUID":"c20815c8-b8ca-4a13-9845-7a124e95f192","DebugName":"HeadHunters_ShipAmbush_Nyx_Hard","Type":"ContractGeneratorHandler_Career","MissionType":{"UUID":"62f92440-202a-43d3-9cb8-b917d4e4a102","Name":"Mercenary"},"MissionGiver":"Headhunters","Title":"Reprisal Attack","TitleKey":"HeadHunters_ShipAmbush_H_title_001","Description":"A squad of ships recently shanked one of our convoys, and ten credits says they\u2019re gonna try and do it again. Looking for someone to launch a reprisal attack before that can happen.  \n\nWe\u2019ve ID\u2019d the idiots as consisting of several large craft and a sizable escort. We believe the leader is flying a <EM4>~mission(AmbushTarget)</EM4> and set that ship as the primary target. Since it\u2019s a sizable and aggressive squad, a surprise attack seems like a smart play. They often pass by <EM4>~mission(Location|Address)</EM4>, which has an emission cloud to hide in. Be smart and patient then strike when the time is right. \n\nUnless you fancy yourself a real ace, it\u2019s probably best to bring some friends. Maybe you can entice folks by letting them know they can pick through the wreckage for valuables once the deed is done.\n\nAnd on top of that, I'll give the main contractor a bonus <EM4>~mission(ScripAmount) Council Scrip</EM4> to sweeten the pot.\n\nStows out.","DescriptionKey":"HeadHunters_ShipAmbush_H_desc_001","DisplayDescription":"A squad of ships recently shanked one of our convoys, and ten credits says they\u2019re gonna try and do it again. Looking for someone to launch a reprisal attack before that can happen.  \n\nWe\u2019ve ID\u2019d the idiots as consisting of several large craft and a sizable escort. We believe the leader is flying a <EM4>[AmbushTarget]</EM4> and set that ship as the primary target. Since it\u2019s a sizable and aggressive squad, a surprise attack seems like a smart play. They often pass by <EM4>Asteroid Mining Base</EM4>, which has an emission cloud to hide in. Be smart and patient then strike when the time is right. \n\nUnless you fancy yourself a real ace, it\u2019s probably best to bring some friends. Maybe you can entice folks by letting them know they can pick through the wreckage for valuables once the deed is done.\n\nAnd on top of that, I'll give the main contractor a bonus <EM4>[ScripAmount] Council Scrip</EM4> to sweeten the pot.\n\nStows out.","LocationPools":{"MissionLocationBP":{"Purpose":"Location","ResolvedLocations":[{"UUID":"8433bf7d-8bfa-4a14-aca8-746d7b9f9472","LocationTemplateUUID":"8433bf7d-8bfa-4a14-aca8-746d7b9f9472","Name":"Asteroid Mining Base","StarmapUUID":"3a9ad441-b058-4712-8911-3c3a3eeb8b56"},{"UUID":"a34b165d-7e98-4e01-9827-0bf1b31f3729","LocationTemplateUUID":"a34b165d-7e98-4e01-9827-0bf1b31f3729","Name":"Asteroid Mining Base","StarmapUUID":"3a9ad441-b058-4712-8911-3c3a3eeb8b56"},{"UUID":"91e239bb-3563-4d12-8b90-9bef128e888c","LocationTemplateUUID":"91e239bb-3563-4d12-8b90-9bef128e888c","Name":"Asteroid Mining Base","StarmapUUID":"3a9ad441-b058-4712-8911-3c3a3eeb8b56"}],"ResourceTags":[{"UUID":"6804b0a9-b01d-4c9a-8063-67784bd0f021","Name":"KillExclusive"}]}},"MissionTokens":{"Location|Address":["Asteroid Mining Base"],"Contractor":["Headhunters"]},"CalculatedReward":true,"TimeToComplete":16.7,"RewardItems":[{"AwardOnlyToMissionOwner":true,"Items":[{"Name":"Council Scrip","UUID":"cea4af31-612e-4d1c-9a03-e358898b5691","Amount":8,"SendToHome":true}]}],"ReputationGained":[{"Faction":"Headhunters","FactionUUID":"9f89edc0-441b-4f40-a502-df12ebf3f1eb","Scope":"FactionReputation","ScopeUUID":"d31bd373-35ab-4ea4-b0a7-0ccc867ef082","Amount":200,"Tier":"Undefined Name"}],"HaulingOrders":[],"MinStanding":{"Name":"Sr. Contractor","MinReputation":5800},"MaxStanding":{"Name":"Elite Contractor","MinReputation":95250},"RankIndex":3,"Prerequisites":[{"RequiredCount":1,"ExcludedCount":1,"RequiredTags":[{"UUID":"9c1d5930-c5c0-4d11-a0f4-45568890747d","Name":"Intro"}],"ExcludedTags":[],"RequiredMissions":[{"UUID":"0aae9359-4b9f-4d9b-af72-1b513594c